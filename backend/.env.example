# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (и других админов) в формате JSON: [123456789, 987654321]. Узнать ID: @userinfobot
ADMIN_IDS=[]
# Аккаунт-релеер для подарков (Telegram Premium, подключён к боту: Настройки → Telegram для бизнеса → Чат-боты)
RELAYER_USER_ID=0
RELAYER_USERNAME=
# Публичный HTTPS-адрес Mini App (cloudflared/ngrok или ваш домен), его же указать в @BotFather → Configure Mini App
WEBAPP_URL=
# Запускать бота вместе с сервером (false — только API, удобно для разработки)
RUN_BOT=true

# ===== База =====
# По умолчанию SQLite рядом с backend. Для продакшена — PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/solup

# ===== Crypto Pay (@CryptoBot → Crypto Pay → Create App) =====
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=false
# Курс TON в долларах на случай, если CryptoPay не ответит
TON_USD_FALLBACK=3

# ===== Экономика =====
# Сколько монет за 1 звезду и за 1 доллар
COINS_PER_STAR=1
COINS_PER_USD=75
# Бонус сверху к пополнению, %
STARS_BONUS_PERCENT=10
CRYPTO_BONUS_PERCENT=10
# Процент с пополнений друзей
REFERRAL_PERCENT=5
# Ежедневный бонус: случайно от и до, монет
DAILY_BONUS_MIN=1
DAILY_BONUS_MAX=25
# Преимущество казино в апгрейде и краше (0.05 = 5%) и максимальный шанс апгрейда
HOUSE_EDGE=0.05
UPGRADE_MAX_CHANCE=0.75
# Вывод подарков без подтверждения админом
WITHDRAW_AUTO=false

# ===== Подвал Mini App =====
# Юзернеймы без @
SUPPORT_USERNAME=
NEWS_CHANNEL=

# ===== Разработка =====
# Открыть Mini App в браузере по адресу /?dev=<user_id>. На боевом сервере обязательно false!
DEV_AUTH=false

# Премиум-эмодзи в сообщениях бота (t.me/addemoji/<имя>)
EMOJI_PACK=solutions_winter_by_solutions_chatbot
