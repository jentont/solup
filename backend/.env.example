# Токен бота от @BotFather
BOT_TOKEN=
# ID админов через запятую в формате JSON: [123456789]
ADMIN_IDS=[]
# Аккаунт-релеер для подарков (Telegram Premium, подключён к боту через «Telegram для бизнеса»)
RELAYER_USER_ID=0
RELAYER_USERNAME=
# Публичный HTTPS-адрес Mini App (cloudflared/ngrok или ваш домен)
WEBAPP_URL=

# База: по умолчанию SQLite рядом с backend. Для продакшена — PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/casino

# Crypto Pay (@CryptoBot → Crypto Pay → Create App)
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=false

# Экономика
COINS_PER_STAR=1
COINS_PER_USD=75
REFERRAL_PERCENT=5
HOUSE_EDGE=0.05
WITHDRAW_AUTO=false

# Только для локальной разработки! Позволяет открыть Mini App в браузере по адресу /?dev=<user_id>
DEV_AUTH=false

# Подвал Mini App
SUPPORT_USERNAME=
NEWS_CHANNEL=
